# ─── Chatwoot ─────────────────────────────────────────────────────────────────
# Learn about Chatwoot environment variables at:
# https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables/
#
# Chatwoot runs in DEVELOPMENT mode (RAILS_ENV=development).
# On first start, db:seed creates a default user:
#   email: john@acme.inc
#   password: Password1!

# Used to verify the integrity of signed cookies. Ensure a secure value is set.
# SECRET_KEY_BASE should be alphanumeric. Avoid special characters or symbols.
# Use `rake secret` to generate this variable
CW_SECRET_KEY_BASE=development

# Replace with the URL you are planning to use for your app
CW_FRONTEND_URL=http://0.0.0.0:8080

# Host port for Chatwoot web UI
CW_PORT=8080

# Postgres database settings
CW_POSTGRES_USER=postgres
CW_POSTGRES_PASSWORD=
CW_POSTGRES_DB=chatwoot
# Host port exposed for Chatwoot Postgres (for external access/debugging)
CW_POSTGRES_PORT=5432

# Redis config
# If you are using docker-compose, set this variable's value to be any string,
# which will be the password for the redis service running inside the docker-compose
# to make it secure
CW_REDIS_PASSWORD=
# Host port exposed for Chatwoot Redis
CW_REDIS_PORT=6379

# Seed user credentials (required)
# These are used to create the initial admin user on first boot.
CW_SEED_EMAIL=
CW_SEED_PASSWORD=

# The email from which all outgoing emails are sent
# Could use either `email@yourdomain.com` or `BrandName <email@yourdomain.com>`
CW_MAILER_SENDER_EMAIL=

# SMTP domain key is set up for HELO checking
# Set the value as "localhost" or your SMTP address
# If SMTP_ADDRESS is empty, Chatwoot would try to use sendmail (postfix)
CW_SMTP_ADDRESS=
CW_SMTP_PORT=587
CW_SMTP_USERNAME=
CW_SMTP_PASSWORD=

# ─── Gateway ─────────────────────────────────────────────────────────────────

# Host port for Gateway API
GW_PORT=8000

# Postgres (PGMQ) image version settings
GW_POSTGRES_VERSION=16
GW_PGMQ_VERSION=v1.9.0

# Database settings
GW_DB_USER=postgres
GW_DB_PASS=
GW_DB_NAME=gateway
# Host port exposed for Gateway Postgres (for external access/debugging)
GW_POSTGRES_PORT=5433

# If set, overrides the token auto-obtained from the seed user by gw-init.
# Leave empty to let gw-init sign in as john@acme.inc and get the token automatically.
# Take from Chatwoot Profile Settings -> Access Token (at the very bottom)
GW_CHATWOOT_ACCESS_TOKEN=

# Set to any value to create a "Test Email Gateway" inbox on first boot. Leave empty to skip.
GW_CREATE_TEST_INBOX=

# Main domain for webhook configuration
GW_WH_DOMAIN=http://localhost:8000

# This is the bots configuration for the Telegram Gateway
# Example: [{"connector_id": "tg1", "bot_token": "0123456789:ABCDEFG", "cw_account_id": "123", "cw_inbox_id": "888"},
#           {"connector_id": "tg2", "bot_token": "1234567890:BCDEFGH", "cw_account_id": "123", "cw_inbox_id": "999"}]
GW_BOTS_CONFIG=[]

# Encryption key that Telegram (or other adapters that support such keys)
# will send to the API in the header
GW_SECRET_TOKEN=

# Email adapter config (JSON array)
# smtp_password defaults to imap_password. Add "smtp_password": "..." to smtp block if different.
# Example: [{"connector_id": "e1", "cw_account_id": "24", "cw_inbox_id": "12",
#            "imap_username": "your_email@example.com", "imap_password": "16-digitPasswordNoSpaces",
#            "smtp": {"smtp_username": "your_email@example.com", "smtp_from": "your_email@example.com"}}]
GW_MAILBOXES_CONFIG=[]

# Queue names
GW_INCOMING_QUEUE_NAME=to_cw
GW_OUTGOING_QUEUE_NAME=from_cw

# Group for plugin auto-discovery
GW_GROUP=helpline.channel_adapters

# In Production, it should be changed to PROD.
# Only "LOCAL", "DEV", "STAGE" and "PROD" are allowed
GW_ENVIRONMENT=LOCAL

# Number of workers to run the app with.
# If WORKERS is 0 or 1, the app will run with a single process (event loop mode).
# If WORKERS >= 2, the app will run in multiprocess mode with one parent process
# and the specified number of worker processes (e.g., WORKERS=3 means 1 parent + 3 workers).
GW_WORKERS=1

# INFO, WARNING, ERROR, DEBUG
GW_LOG_LEVEL=INFO

GW_ANONYMIZE_USERS=True

# OpenTelemetry settings
GW_OTEL_ENABLED=false
GW_OTEL_SERVICE_NAME=gateway
# Leave empty to disable OTLP export and send traces only to Sentry
GW_OTEL_ENDPOINT=

# Sentry settings
GW_SENTRY_DSN=
